{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fira:schema:1.0-frozen+corr1-4:s02-audit-profile",
  "title": "S2 AuditProfile",
  "description": "S2 from schema-formalization.md (POLICY data shape). The 5 profile instances are Task 8 data; this is the schema only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "description",
    "gates",
    "focus_areas",
    "typical_failure_modes",
    "minimum_evidence_expectations"
  ],
  "properties": {
    "profile_id": {
      "$ref": "urn:fira:schema:1.0-frozen+corr1-4:_defs:common#/$defs/ProfileId"
    },
    "version": {
      "$ref": "urn:fira:schema:1.0-frozen+corr1-4:_defs:common#/$defs/Semver"
    },
    "description": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "requirement_level"],
        "properties": {
          "gate": {
            "$ref": "urn:fira:schema:1.0-frozen+corr1-4:_defs:common#/$defs/GateName"
          },
          "requirement_level": {
            "$ref": "urn:fira:schema:1.0-frozen+corr1-4:_defs:common#/$defs/RequirementLevel"
          },
          "na_justification": {
            "type": "string"
          }
        }
      }
    },
    "focus_areas": {
      "type": "array",
      "items": { "type": "string" }
    },
    "typical_failure_modes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "minimum_evidence_expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "expectation"],
        "properties": {
          "gate": {
            "$ref": "urn:fira:schema:1.0-frozen+corr1-4:_defs:common#/$defs/GateName"
          },
          "expectation": { "type": "string" }
        }
      }
    }
  }
}
